# Опрос устройств Observium (cron в контейнере).
# poller собирает метрики каждые 5 минут, discovery обновляет список
# устройств и LLDP-соседей каждые 6 минут.
*/5 * * * * root /opt/observium/poller.php -h all >> /dev/null 2>&1
*/6 * * * * root /opt/observium/discovery.php -h all >> /dev/null 2>&1
